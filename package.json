{
  "name": "text-to-sql-agent",
  "version": "0.1.0",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "=========UTILS==========================================================================================": "",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "rm -rf .husky && husky && echo \"bun install\" > .husky/post-merge && chmod +x .husky/post-merge && echo \"bun run lint-staged\" > .husky/pre-commit && chmod +x .husky/pre-commit && echo \"bun run build\" > .husky/pre-push && chmod +x .husky/pre-push",
    "========CLEANUP===================================================================================": "",
    "cleanup": "rm -rf node_modules .next *.tsbuildinfo .husky logs",
    "verify": "bun run typecheck && bun run format:check && bun run lint && bun run build",
    "cid": "bun run cleanup && bun install && bun run verify",
    "bun:cleanup": "bun update && bun prune && bun dedupe && bun audit fix"
  },
  "lint-staged": {
    "**/*.{jsx,tsx,js,cjs,mjs,ts,cts,mts,json,jsonc,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.21",
    "@langchain/openai": "^1.6.2",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "mysql2": "^3.24.5",
    "next": "16.4.0",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "uuid": "11.1.1"
  }
}
